{
  "rewrites": [
    { "source": "/proxy", "destination": "/api/proxy" },
    { "source": "/api/captcha", "destination": "/api/account?r=captcha" },
    { "source": "/api/register", "destination": "/api/account?r=register" },
    { "source": "/api/login", "destination": "/api/account?r=login" },
    { "source": "/api/logout", "destination": "/api/account?r=logout" },
    { "source": "/api/data", "destination": "/api/account?r=data" },
    { "source": "/api/account/delete", "destination": "/api/account?r=delete" },
    { "source": "/api/account/avatar", "destination": "/api/account?r=avatar" },
    { "source": "/api/account/profile", "destination": "/api/account?r=profile" },
    { "source": "/api/account/password", "destination": "/api/account?r=password" },
    { "source": "/api/account/nickname", "destination": "/api/account?r=nickname" },
    { "source": "/api/share", "destination": "/api/account?r=share" },
    { "source": "/s/:type/:id", "destination": "/api/preview?type=:type&id=:id" }
  ],
  "headers": [
    {
      "source": "/(js|css)/(.*)",
      "headers": [
        { "key": "Cache-Control", "value": "public, max-age=0, must-revalidate" }
      ]
    }
  ]
}
